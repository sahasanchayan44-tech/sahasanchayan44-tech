{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlueprintPublicGitHubDataSchema",
  "description": "Authoritative schema for public, unauthenticated GitHub read-only data snapshots in BLUEPRINT / FORGE RUNTIME.",
  "type": "object",
  "required": [
    "provenance",
    "user",
    "telemetry",
    "repositories",
    "historical_milestones",
    "recent_repository_commits",
    "limitations"
  ],
  "properties": {
    "provenance": {
      "type": "object",
      "required": [
        "collected_at_utc",
        "collector_version",
        "access_mode",
        "primary_source",
        "rate_limit_snapshot"
      ],
      "properties": {
        "collected_at_utc": { "type": "string", "format": "date-time" },
        "collector_version": { "type": "string" },
        "access_mode": { "type": "string", "enum": ["UNAUTHENTICATED_PUBLIC_REST"] },
        "primary_source": { "type": "string" },
        "rate_limit_snapshot": {
          "type": "object",
          "required": ["limit", "remaining", "reset_utc", "used"],
          "properties": {
            "limit": { "type": "integer" },
            "remaining": { "type": "integer" },
            "reset_utc": { "type": "string", "format": "date-time" },
            "used": { "type": "integer" }
          }
        }
      }
    },
    "user": {
      "type": "object",
      "required": [
        "login",
        "id",
        "created_at",
        "public_repos",
        "followers",
        "following",
        "public_gists",
        "html_url"
      ],
      "properties": {
        "login": { "type": "string" },
        "id": { "type": "integer" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": ["string", "null"] },
        "public_repos": { "type": "integer", "minimum": 0 },
        "followers": { "type": "integer", "minimum": 0 },
        "following": { "type": "integer", "minimum": 0 },
        "public_gists": { "type": "integer", "minimum": 0 },
        "html_url": { "type": "string", "format": "uri" }
      }
    },
    "telemetry": {
      "type": "object",
      "required": [
        "total_stars",
        "total_forks",
        "account_age_days",
        "primary_ecosystems",
        "public_events_90d_count"
      ],
      "properties": {
        "total_stars": { "type": "integer", "minimum": 0 },
        "total_forks": { "type": "integer", "minimum": 0 },
        "account_age_days": { "type": "integer", "minimum": 0 },
        "primary_ecosystems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "public_events_90d_count": { "type": "integer", "minimum": 0 }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "project_id",
          "category",
          "repo_url",
          "default_branch",
          "stars",
          "forks"
        ],
        "properties": {
          "name": { "type": "string" },
          "project_id": { "type": "string" },
          "category": { "type": "string" },
          "primary_language": { "type": ["string", "null"] },
          "languages": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "integer" }
          },
          "stars": { "type": "integer", "minimum": 0 },
          "forks": { "type": "integer", "minimum": 0 },
          "default_branch": { "type": "string" },
          "created_at": { "type": ["string", "null"] },
          "updated_at": { "type": ["string", "null"] },
          "pushed_at": { "type": ["string", "null"] },
          "repo_url": { "type": "string", "format": "uri" },
          "api_description": { "type": ["string", "null"] },
          "architectural_description": { "type": "string" },
          "architecture": { "type": "string" },
          "key_components": {
            "type": "array",
            "items": { "type": "string" }
          },
          "provenance": {
            "type": "object",
            "properties": {
              "metadata_source": { "type": "string" },
              "architecture_source": { "type": "string" }
            }
          }
        }
      }
    },
    "historical_milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "log_id",
          "timestamp_display",
          "repository",
          "commit_sha",
          "message",
          "verification_status"
        ],
        "properties": {
          "log_id": { "type": "string" },
          "timestamp_display": { "type": "string" },
          "timestamp_iso": { "type": ["string", "null"] },
          "repository": { "type": "string" },
          "commit_sha": { "type": "string" },
          "commit_url": { "type": ["string", "null"] },
          "author_login": { "type": ["string", "null"] },
          "message": { "type": "string" },
          "verification_status": { "type": "string" }
        }
      }
    },
    "recent_repository_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "commit_sha",
          "commit_url",
          "message",
          "committed_at"
        ],
        "properties": {
          "repository": { "type": "string" },
          "commit_sha": { "type": "string" },
          "commit_url": { "type": "string" },
          "author_login": { "type": ["string", "null"] },
          "message": { "type": "string" },
          "committed_at": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "object",
      "required": [
        "contribution_calendar",
        "events_window",
        "graphql_access",
        "rate_limit_policy"
      ],
      "properties": {
        "contribution_calendar": { "type": "string" },
        "events_window": { "type": "string" },
        "graphql_access": { "type": "string" },
        "rate_limit_policy": { "type": "string" }
      }
    }
  }
}
